[user-account]
;学校留空时 username 填手机号，填写学校全称时 username 填学号
;账号或密码留空则在浏览器中手动登录
username =
password =
school =

[browser-option]
;配置浏览器,可选 Edge 或 Chrome
driver = Edge
;指定浏览器所在路径,不填则使用默认路径
EXE_PATH =

[script-option]
;是否自动过登录时的滑块验证(默认:True)
enableAutoCaptcha = True
;是否自动隐藏浏览器窗口(默认:False)
enableHideWindow = False

[deepseek]
;填写自己的 DeepSeek API Key 启用自动答题，留空时手动作答
api_key =

[course-option]
;限制每门课程运行时长/min (不限制:0)
limitMaxTime = 0
;限定播放倍速 (最高:1.8)
limitSpeed = 1.5
;设置是否静音播放 (默认:True)
soundOff = True

[course-url]
;配置要学习的课程链接,支持(智慧)共享课
;可继续添加多个课程链接
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
