[user-account]
;学校留空时 username 填手机号，填写学校全称时 username 填学号
;账号或密码留空则在浏览器中手动登录
username =
password =
school =

[browser-option]
;macOS 默认启动独立 Chrome，EXE_PATH 通常留空
driver = Chrome
EXE_PATH =
;实验性：连接已开启远程调试的日常 Chrome
attachExistingChrome = False
cdpUrl = http://127.0.0.1:9222

[script-option]
;自动滑块只支持登录页，课中安全验证仍需手动完成
enableAutoCaptcha = False
enableHideWindow = False

[deepseek]
;填写自己的 DeepSeek API Key 启用自动答题，留空时手动作答
api_key =

[course-option]
;限制每门课程运行时长/min (不限制:0)
limitMaxTime = 0
limitSpeed = 1.5
soundOff = True

[course-url]
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
